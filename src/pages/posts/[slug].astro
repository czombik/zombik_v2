---
import { render } from 'astro:content';
import LocalImage from '../../components/LocalImage.astro';
import TagList from '../../components/TagList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPostBySlug, getPostSlugs } from '../../lib/content';
import { formatDate } from '../../lib/format';

export async function getStaticPaths() {
  const slugs = await getPostSlugs();

  return slugs.map((slug) => ({
    params: { slug },
  }));
}

const slug = Astro.params.slug ?? '';
const post = await getPostBySlug(slug);

if (!post) {
  throw new Error(`Post not found for slug: ${slug}`);
}
const { Content } = await render(post.entry);
---

<BaseLayout
  title={post.title}
  description={post.excerpt}
  socialImage={post.heroImage}
  socialImageAlt={post.heroImageAlt ?? post.title}
>
  <article class="post-page reveal">
    <header class="post-header">
      <p class="post-meta">
        <span>{formatDate(post.publishedAt)}</span>
      </p>

      <div class="post-title-block">
        <h1>{post.title}</h1>
      </div>
      <TagList tags={post.tags} hrefBase="/posts" />

      <LocalImage
        image={post.heroImage}
        alt={post.heroImageAlt ?? post.title}
        class="post-hero"
        loading="eager"
      />
    </header>

    <div class="rich-text"><Content /></div>
  </article>
</BaseLayout>
