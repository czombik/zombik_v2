---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPageEntry } from '../lib/content';

const nowPage = await getPageEntry('now');
if (nowPage.data.type !== 'now') throw new Error('Now content has the wrong page type.');
const { Content } = await render(nowPage);
---

<BaseLayout title="Now" description="What Chris Zombik is focused on now.">
  <article class="now-page reveal">
    <header class="now-header">
      <h1>{nowPage.data.title}</h1>
    </header>

    <section class="now-content">
      <div class="rich-text"><Content /></div>
    </section>
  </article>
</BaseLayout>
