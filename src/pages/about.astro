---
import { render } from 'astro:content';
import LocalImage from '../components/LocalImage.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAuthorData, getPageEntry } from '../lib/content';

const [aboutPage, author] = await Promise.all([getPageEntry('about'), getAuthorData()]);
if (aboutPage.data.type !== 'about') throw new Error('About content has the wrong page type.');
const { Content } = await render(aboutPage);
const blueskyUrl = 'https://bsky.app/profile/chriszombik.com';
const socialLinks = [...(author.socialLinks ?? [])];

if (!socialLinks.some((link) => link.url === blueskyUrl)) {
  socialLinks.push({ label: 'Bluesky', url: blueskyUrl });
}
---

<BaseLayout title="About" description="About Chris Zombik.">
  <article class="about-page reveal">
    <header class="about-header">
      <div>
        <h1>{aboutPage.data.title}</h1>
      </div>

      <LocalImage
        image={author.portrait}
        alt={author.portraitAlt ?? author.name}
        class="about-portrait"
        sizes="(max-width: 900px) 92vw, 280px"
      />
    </header>

    <div class="rich-text about-rich-text"><Content /></div>

    {socialLinks.length > 0 && (
      <footer class="about-links">
        <h2>Elsewhere</h2>
        <ul>
          {socialLinks.map((link) => (
            <li>
              <a href={link.url} target="_blank" rel="noreferrer noopener">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </footer>
    )}
  </article>
</BaseLayout>
