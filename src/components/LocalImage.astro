---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image?: ImageMetadata;
  alt?: string;
  class?: string;
  sizes?: string;
  loading?: 'lazy' | 'eager';
}

const {
  image,
  alt = '',
  class: className = '',
  sizes = '(max-width: 800px) 92vw, 720px',
  loading = 'lazy',
} = Astro.props;
---

{
  image && (
    <Image
      src={image}
      alt={alt}
      class={className}
      widths={[480, 768, 1024, 1440]}
      sizes={sizes}
      loading={loading}
      decoding="async"
    />
  )
}
