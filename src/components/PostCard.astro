---
import type { PostCardData, WritingCardData } from '../lib/sanity.types';
import SanityImage from './SanityImage.astro';
import TagList from './TagList.astro';

interface Props {
  post: PostCardData | WritingCardData;
  hrefPrefix?: string;
  showHeroImage?: boolean;
  showTags?: boolean;
  showExcerpt?: boolean;
  layout?: 'stacked' | 'horizontal';
}

const {
  post,
  hrefPrefix = '/posts',
  showHeroImage = true,
  showTags = true,
  showExcerpt = true,
  layout = 'stacked',
} = Astro.props;
const href = `${hrefPrefix}/${post.slug}`;
---

<article
  class:list={[
    'post-card',
    {
      'post-card-no-image': !showHeroImage,
      'post-card-horizontal': layout === 'horizontal',
    },
  ]}
>
  {showHeroImage && (
    <a class="post-card-image-wrap" href={href}>
      <SanityImage
        image={post.heroImage}
        alt={post.heroImage?.alt ?? post.title}
        class="post-card-image"
        sizes="(max-width: 980px) 92vw, 520px"
      />
    </a>
  )}

  <div class="post-card-content">
    <h3 class="post-card-title">
      <a href={href}>{post.title}</a>
    </h3>

    {showExcerpt && <p class="post-card-excerpt">{post.excerpt}</p>}

    {showTags && <TagList tags={post.tags} hrefBase={hrefPrefix} />}
  </div>
</article>
